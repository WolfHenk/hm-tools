#!/bin/sh

ADDON_NAME=hm-tools
LICENSES_DIR=licenses
CONFIG_DIR=/usr/local/etc/config
WWW_DIR=/usr/local/etc/config/addons/www/hm-tools
ADDON_DIR=/usr/local/addons/${ADDON_NAME}
PROFILE_DIR=/usr/local/etc/profile.d
RCD_DIR=${CONFIG_DIR}/rc.d

TOOL_MC=mc
TOOL_NANO=nano
TOOL_HTOP=htop
TOOL_BASH=bash
TOOL_IMAGEMAGICK=imagemagick
TOOL_SSHPASS=sshpass
TOOL_OATHTOOL=oathtool
TOOL_IOSTAT=iostat

ARCH="$(uname -m 2>/dev/null)"
MODEL="unknown"
if [ -r /proc/device-tree/model ]; then
  MODEL="$(tr -d '\000' </proc/device-tree/model 2>/dev/null)"
fi

# Select the binary set explicitly. Raspberry Pi 5 and Compute Module 5
# run RaspberryMatic as 64-bit ARM and therefore use the aarch64 payload.
case "${ARCH}" in
  aarch64|arm64)
    FILE_DIR=aarch64
    ;;
  armv6l|armv7l|armv8l|arm)
    FILE_DIR=arm
    ;;
  i386|i486|i586|i686|x86_64|amd64)
    FILE_DIR=x86
    ;;
  *)
    echo "hm-tools: unsupported architecture '${ARCH}' (model: ${MODEL})" >&2
    exit 1
    ;;
esac

# make sure this addon is only executed on RaspberryMatic
if [ "$1" = "HM-RASPBERRYMATIC" ]; then
  if [ -n "${LOG_FILE:-}" ]; then
    echo "$1" >>"${LOG_FILE}"
    echo "hm-tools: model=${MODEL}, arch=${ARCH}, payload=${FILE_DIR}" >>"${LOG_FILE}"
  fi

  if ! mount | grep -q ' /usr/local '; then
    mount /usr/local || exit 1
  fi

  # create necessary directories
  mkdir -p "${ADDON_DIR}" "${WWW_DIR}" "${RCD_DIR}" "${PROFILE_DIR}" || exit 1
  chmod 755 "${ADDON_DIR}" "${WWW_DIR}" "${RCD_DIR}" "${PROFILE_DIR}"

  # remove old stuff
  rm -rf "${ADDON_DIR:?}/"*

  # copy profile.d
  cp -af profile.d/* "${PROFILE_DIR}/"

  # copy licenses
  cp -af "${LICENSES_DIR}" "${ADDON_DIR}/"

  copy_tool() {
    tool="$1"
    src="${FILE_DIR}/${tool}"

    if [ ! -d "${src}" ]; then
      echo "hm-tools: missing package '${src}'" >&2
      exit 1
    fi

    if [ "${FILE_DIR}" = "aarch64" ] && [ -d "${src}/payload" ]; then
      payload_tmp="/tmp/hm-tools-${tool}-runtime.tgz"
      rm -f "${payload_tmp}"
      cat "${src}"/payload/${tool}-runtime.tgz.part-* >"${payload_tmp}" || exit 1
      tar -xzf "${payload_tmp}" -C "${ADDON_DIR}" || exit 1
      rm -f "${payload_tmp}"
    else
      cp -af "${src}/"* "${ADDON_DIR}/" || exit 1
    fi
  }

  ### Hier können einzelne Programme !!! abgewählt !!! werden ###
  # Zum Abwählen die jeweilige copy_tool-Zeile auskommentieren.

  # copy addon mc
  copy_tool "${TOOL_MC}"

  # copy addon nano
  copy_tool "${TOOL_NANO}"

  # copy addon htop
  copy_tool "${TOOL_HTOP}"

  # copy addon bash
  copy_tool "${TOOL_BASH}"

  # copy addon imagemagick
  copy_tool "${TOOL_IMAGEMAGICK}"

  # copy addon sshpass
  copy_tool "${TOOL_SSHPASS}"

  # copy addon oathtool
  copy_tool "${TOOL_OATHTOOL}"

  # copy addon iostat
  copy_tool "${TOOL_IOSTAT}"

  ###############################################################

  # copy web-configuration
  cp -af www/* "${WWW_DIR}/"

  # copy version
  cp -af VERSION "${ADDON_DIR}/"

  # copy startup script
  cp -af rc.d/* "${RCD_DIR}/"

  # build system launcher
  chmod +x "${RCD_DIR}/${ADDON_NAME}"
fi

# synchronize filesystem before performing a reboot afterwards
sync
